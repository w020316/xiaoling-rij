generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nickname     String   @default("小林")
  avatar       String?
  checkInDays  Int      @default(0)
  lastCheckIn  DateTime?
  theme        String   @default("theme-kuromi")
  coupleId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  couple       Couple?  @relation(fields: [coupleId], references: [id])
  todos        Todo[]
  diaries      Diary[]
  photos       Photo[]
  emotions     EmotionRecord[]
  checkIns     CheckIn[]
  messages     Message[]
  periodRecords PeriodRecord[]
  calorieRecords CalorieRecord[]
}

model Todo {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  category    String   @default("默认")
  tags        String?
  priority    String   @default("normal")
  status      String   @default("pending")
  sortOrder   Int      @default(0)
  isRepeat    Boolean  @default(false)
  repeatRule  String?
  remindAt    DateTime?
  attachments String?
  isDone      Boolean  @default(false)
  aiGenerated Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
}

model Diary {
  id          String   @id @default(cuid())
  title       String?
  content     String
  tags        String?
  location    String?
  weather     String?
  mood        String?
  images      String?
  diaryType   String   @default("text")
  aiExpanded  Boolean  @default(false)
  aiContent   String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
}

model Photo {
  id          String   @id @default(cuid())
  url         String
  thumbnail   String?
  description String?
  location    String?
  photoTime   DateTime?
  category    String   @default("all")
  aiTags      String?
  aiScene     String?
  isFavorite  Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
}

model Couple {
  id           String   @id @default(cuid())
  inviteCode   String   @unique
  startDate    DateTime @default(now())
  nickname1    String   @default("TA")
  nickname2    String   @default("TA")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  anniversaries Anniversary[]
  wishLists    WishList[]
  savingsGoals SavingsGoal[]
}

model Anniversary {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  remindDays  Int      @default(3)
  type        String   @default("custom")
  coupleId    String?
  createdAt   DateTime @default(now())

  couple      Couple?  @relation(fields: [coupleId], references: [id])
}

model WishList {
  id          String   @id @default(cuid())
  title       String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  coupleId    String?
  createdAt   DateTime @default(now())

  couple      Couple?  @relation(fields: [coupleId], references: [id])
}

model SavingsGoal {
  id          String   @id @default(cuid())
  title       String
  target      Float    @default(0)
  current     Float    @default(0)
  coupleId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  couple      Couple?  @relation(fields: [coupleId], references: [id])
}

model EmotionRecord {
  id          String   @id @default(cuid())
  mood        String
  score       Int      @default(5)
  note        String?
  userId      String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model CheckIn {
  id          String   @id @default(cuid())
  type        String   @default("daily")
  userId      String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  role        String
  content     String
  images      String?
  userId      String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model AiLog {
  id          String   @id @default(cuid())
  type        String
  input       String
  output      String
  tokens      Int      @default(0)
  createdAt   DateTime @default(now())
}

model PeriodRecord {
  id          String   @id @default(cuid())
  startDate   DateTime
  endDate     DateTime?
  cycleDays   Int      @default(28)
  symptoms    String?
  userId      String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model CalorieRecord {
  id          String   @id @default(cuid())
  foodName    String
  calories    Int      @default(0)
  protein     Float    @default(0)
  fat         Float    @default(0)
  carbs       Float    @default(0)
  mealType    String   @default("lunch")
  date        DateTime @default(now())
  userId      String?

  user        User?    @relation(fields: [userId], references: [id])
}

model Schedule {
  id        String   @id @default(cuid())
  timeStart String
  timeEnd   String
  title     String
  dayOfWeek Int      @default(1)
  createdAt DateTime @default(now())
}

model DailyQuote {
  id        String   @id @default(cuid())
  content   String
  author    String?
  date      DateTime @default(now())
}

model WeatherCache {
  id          String   @id @default(cuid())
  city        String
  temperature String
  description String
  icon        String?
  fetchedAt   DateTime @default(now())
}
